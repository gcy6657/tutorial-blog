---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Comments from '../components/Comments.astro';
import SeriesNav from '../components/SeriesNav.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { formatDate, postUrl, readingStats, seriesUrl, type Post, type Series } from '../utils/posts';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  prev?: Post;
  next?: Post;
  /** 章节所在的系列；单篇文章不传 */
  series?: Series;
}

const { post, headings, prev, next, series } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const stats = readingStats(post.body);
const chapterIndex = series ? series.chapters.findIndex((c) => c.id === post.id) + 1 : 0;
const unit = series ? '章' : '篇';
---

<BaseLayout title={title} description={description}>
  <article>
    <header>
      {series && (
        <p class="crumb">
          <a href={seriesUrl(series.entry.id)}>{series.entry.data.title}</a>
          <span class="muted"> · 第 {chapterIndex} 章</span>
        </p>
      )}
      <h1>{title}</h1>
      <p class="meta muted">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span> · 更新于 {formatDate(updatedDate)}</span>}
        <span> · {stats.words} 字 · 约 {stats.minutes} 分钟</span>
      </p>
      {tags.length > 0 && (
        <p class="tags">
          {tags.map((tag) => <a class="tag" href={`/tags/${tag}/`}>#{tag}</a>)}
        </p>
      )}
    </header>
    {series && <SeriesNav series={series} current={post} />}
    <TableOfContents headings={headings} />
    <div class="prose">
      <slot />
    </div>
  </article>

  {(prev || next) && (
    <nav class="post-nav">
      {prev ? (
        <a class="prev" href={postUrl(prev)}><span class="muted">← 上一{unit}</span>{prev.data.title}</a>
      ) : <span />}
      {next && (
        <a class="next" href={postUrl(next)}><span class="muted">下一{unit} →</span>{next.data.title}</a>
      )}
    </nav>
  )}

  <Comments />
</BaseLayout>

<style>
  .crumb { margin: 0 0 0.4rem; font-size: 0.95rem; }
  h1 { margin-bottom: 0.25rem; font-size: 2rem; }
  .meta { margin: 0; font-size: 0.95rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.75rem 0 0; }
  .prose { margin-top: 2rem; overflow-wrap: break-word; }
  .prose :global(h2) {
    margin-top: 2.5rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 1.5rem;
  }
  .prose :global(h3) { scroll-margin-top: 1.5rem; }
  .prose :global(h2)::before { content: '# '; color: var(--accent); opacity: 0.7; }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
  }
  .post-nav a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card-bg);
    color: var(--fg);
    transition: border-color 0.2s, transform 0.2s;
  }
  .post-nav a:hover { border-color: var(--accent); text-decoration: none; transform: translateY(-2px); }
  .post-nav span { font-size: 0.85rem; }
  .next { text-align: right; grid-column: 2; }
  @media (max-width: 560px) {
    .post-nav { grid-template-columns: 1fr; }
    .next { grid-column: 1; }
  }
</style>
