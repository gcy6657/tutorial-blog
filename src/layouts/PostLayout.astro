---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Comments from '../components/Comments.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { formatDate, readingStats, type Post } from '../utils/posts';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  newer?: Post;
  older?: Post;
}

const { post, headings, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const stats = readingStats(post.body);
---

<BaseLayout title={title} description={description}>
  <article>
    <header>
      <h1>{title}</h1>
      <p class="meta muted">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span> · 更新于 {formatDate(updatedDate)}</span>}
        <span> · {stats.words} 字 · 约 {stats.minutes} 分钟</span>
      </p>
      {tags.length > 0 && (
        <p class="tags">
          {tags.map((tag) => <a class="tag" href={`/tags/${tag}/`}>#{tag}</a>)}
        </p>
      )}
    </header>
    <TableOfContents headings={headings} />
    <div class="prose">
      <slot />
    </div>
  </article>

  {(newer || older) && (
    <nav class="post-nav">
      {older ? (
        <a class="older" href={`/blog/${older.id}/`}><span class="muted">← 上一篇</span>{older.data.title}</a>
      ) : <span />}
      {newer && (
        <a class="newer" href={`/blog/${newer.id}/`}><span class="muted">下一篇 →</span>{newer.data.title}</a>
      )}
    </nav>
  )}

  <Comments />
</BaseLayout>

<style>
  h1 { margin-bottom: 0.25rem; font-size: 2rem; }
  .meta { margin: 0; font-size: 0.95rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.75rem 0 0; }
  .prose { margin-top: 2rem; overflow-wrap: break-word; }
  .prose :global(h2) {
    margin-top: 2.5rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 1.5rem;
  }
  .prose :global(h3) { scroll-margin-top: 1.5rem; }
  .prose :global(h2)::before { content: '# '; color: var(--accent); opacity: 0.7; }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
  }
  .post-nav a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card-bg);
    color: var(--fg);
    transition: border-color 0.2s, transform 0.2s;
  }
  .post-nav a:hover { border-color: var(--accent); text-decoration: none; transform: translateY(-2px); }
  .post-nav span { font-size: 0.85rem; }
  .newer { text-align: right; grid-column: 2; }
  @media (max-width: 560px) {
    .post-nav { grid-template-columns: 1fr; }
    .newer { grid-column: 1; }
  }
</style>
