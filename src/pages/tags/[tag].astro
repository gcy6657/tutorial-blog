---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { collectTags, getPublishedPosts, type Post } from '../../utils/posts';

export async function getStaticPaths() {
  const tags = collectTags(await getPublishedPosts());
  return [...tags.entries()].map(([tag, posts]) => ({ params: { tag }, props: { posts } }));
}

const { tag } = Astro.params;
const { posts } = Astro.props as { posts: Post[] };
---

<BaseLayout title={`#${tag}`}>
  <h1>#{tag}</h1>
  <p class="muted">共 {posts.length} 篇 · <a href="/tags/">全部标签</a></p>
  <PostList posts={posts} />
</BaseLayout>
