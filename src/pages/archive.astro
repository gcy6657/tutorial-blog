---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, groupByYear } from '../utils/posts';

const posts = await getPublishedPosts();
const years = groupByYear(posts);
const monthDay = (d: Date) =>
  d.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit', timeZone: 'UTC' });
---

<BaseLayout title="归档">
  <h1>归档</h1>
  <p class="muted">共 {posts.length} 篇文章</p>
  {years.map(([year, list]) => (
    <section>
      <h2>{year} <span class="muted">({list.length})</span></h2>
      <ul>
        {list.map((post) => (
          <li>
            <time class="muted" datetime={post.data.pubDate.toISOString()}>{monthDay(post.data.pubDate)}</time>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<style>
  h2 span { font-size: 0.9rem; font-weight: normal; }
  ul { list-style: none; padding: 0; }
  li { display: flex; gap: 1rem; padding: 0.3rem 0; }
  time { flex-shrink: 0; font-variant-numeric: tabular-nums; }
</style>
