---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatDate, getAllSeries, postUrl, readingStats, seriesUpdatedAt, type Series } from '../../../utils/posts';

export async function getStaticPaths() {
  const allSeries = await getAllSeries();
  return allSeries.map((series) => ({ params: { series: series.entry.id }, props: { series } }));
}

const { series } = Astro.props as { series: Series };
const { title, description } = series.entry.data;
const { Content } = await render(series.entry);
const totalMinutes = series.chapters.reduce((sum, c) => sum + readingStats(c.body).minutes, 0);
---

<BaseLayout title={title} description={description}>
  <header>
    <p class="crumb"><a href="/">首页</a><span class="muted"> / 系列</span></p>
    <h1>{title}</h1>
    <p class="meta muted">
      共 {series.chapters.length} 章 · 约 {totalMinutes} 分钟 · 更新于 {formatDate(seriesUpdatedAt(series))}
    </p>
  </header>
  <div class="intro"><Content /></div>

  <h2>章节目录</h2>
  <ol class="chapters">
    {series.chapters.map((chapter, i) => (
      <li>
        <a href={postUrl(chapter)}>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <span class="body">
            <span class="title">
              {chapter.data.title}
              {chapter.data.draft && <span class="tag">草稿</span>}
            </span>
            {chapter.data.description && <span class="desc muted">{chapter.data.description}</span>}
          </span>
        </a>
      </li>
    ))}
  </ol>
  {series.chapters[0] && (
    <p><a class="start" href={postUrl(series.chapters[0])}>从第 1 章开始阅读 →</a></p>
  )}
</BaseLayout>

<style>
  .crumb { margin: 1rem 0 0.4rem; font-size: 0.95rem; }
  h1 { margin: 0 0 0.25rem; font-size: 2rem; }
  .meta { margin: 0; font-size: 0.95rem; }
  .intro { margin: 1.5rem 0 2rem; }
  .chapters { list-style: none; padding: 0; margin: 0; }
  .chapters li { border-bottom: 1px solid var(--border); }
  .chapters li:last-child { border-bottom: 0; }
  .chapters a { display: flex; gap: 1rem; padding: 1rem 0; color: var(--fg); }
  .chapters a:hover { text-decoration: none; }
  .chapters a:hover .title { color: var(--accent); }
  .num {
    flex-shrink: 0;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--accent);
    opacity: 0.75;
    font-variant-numeric: tabular-nums;
  }
  .body { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
  .title { font-size: 1.1rem; font-weight: 600; }
  .title .tag { margin-left: 0.4rem; font-size: 0.8rem; font-weight: normal; }
  .desc { font-size: 0.95rem; }
  .start { font-weight: 600; }
</style>
