---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getPublishedPosts, type Post } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  // posts 按时间倒序：前一项更新，后一项更旧
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props as { post: Post; newer?: Post; older?: Post };
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings} newer={newer} older={older}>
  <Content />
</PostLayout>
