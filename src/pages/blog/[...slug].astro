---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getStandalonePosts, type Post } from '../../utils/posts';

// 只生成单篇文章；系列章节在 /series/<系列>/<章节>/
export async function getStaticPaths() {
  const posts = await getStandalonePosts();
  // posts 按时间倒序：前一项更新，后一项更旧
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, next: posts[i - 1], prev: posts[i + 1] },
  }));
}

const { post, prev, next } = Astro.props as { post: Post; prev?: Post; next?: Post };
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings} prev={prev} next={next}>
  <Content />
</PostLayout>
